<?xml version="1.0" encoding="UTF-8"?>
<project name="FidnessAvance2" default="jar" basedir=".">
    <property file="nbproject/project.properties"/>
    <target name="init">
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>
    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}" release="17"
               encoding="${source.encoding}" includeantruntime="false" debug="true"/>
    </target>
    <target name="jar" depends="compile">
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}" manifest="${manifest.file}"/>
    </target>
    <target name="run" depends="compile">
        <java classname="${main.class}" classpath="${build.classes.dir}" fork="true" failonerror="true"/>
    </target>
    <target name="compile-single" depends="compile"/>
    <target name="run-single" depends="compile">
        <java classname="${run.class}" classpath="${build.classes.dir}" fork="true" failonerror="true"/>
    </target>
    <target name="debug" depends="compile">
        <nbjpdastart addressproperty="jpda.address" name="Fidness" transport="dt_socket"/>
        <java classname="${main.class}" classpath="${build.classes.dir}" fork="true" failonerror="true">
            <jvmarg value="-agentlib:jdwp=transport=dt_socket,address=${jpda.address},server=n,suspend=y"/>
        </java>
    </target>
    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>
    <target name="rebuild" depends="clean,jar"/>
    <target name="default" depends="jar"/>
</project>
